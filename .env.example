# Example environment variables — DO NOT COMMIT real secrets
# Copy this file to `.env` and fill the values locally.
#
# 1. Copia este archivo:  cp .env.example .env
# 2. Rellena los valores reales en .env
# 3. NUNCA subas .env a Git (.gitignore ya lo ignora)

# ── Discord Bot (requerido para /api/discord-events) ──────────
# Token del bot — se obtiene en https://discord.com/developers/applications → Bot → Token
# IMPORTANTE: pega SOLO el token (sin prefijo "Bot " y sin comillas)
DISCORD_BOT_TOKEN=

# ID numérico del servidor — click derecho en el servidor → Copiar ID del servidor
DISCORD_GUILD_ID=

# ── Login con Discord (OAuth2, /api/auth/*) ────────────────────
# Client ID/Secret de la MISMA Application de Discord que usa el bot
# purgatory-sync (Developer Portal → tu app → OAuth2). Son credenciales
# distintas del Bot Token de arriba, aunque vivan en la misma Application.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Debe coincidir EXACTO con un Redirect URI registrado en OAuth2 → Redirects
# de esa Application. En prod: https://purg4t0ry.com/api/auth/callback
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/callback

# Connection string del rol de SOLO LECTURA (no el del bot) — ver
# purgatory-sync/sql/0002_web_read_role.sql. Puerto 6543 (el pooler).
DATABASE_URL=

# Secreto para firmar la cookie de sesión — generar con: openssl rand -hex 32
# Rotarlo cierra la sesión de todo el mundo (no hay revocación individual).
SESSION_SECRET=

# ── Notas ─────────────────────────────────────────────────────
# - Si accidentalmente subiste secretos, rótalos inmediatamente.
# - El bot debe estar invitado al servidor con el scope "bot".
# - No necesita permisos especiales para LEER eventos; para crear/editar necesita "Manage Events".
# - El login (identify) NO necesita el bot token ni el scope "bot" — es un
#   flujo de OAuth2 completamente aparte, contra la misma Application.
