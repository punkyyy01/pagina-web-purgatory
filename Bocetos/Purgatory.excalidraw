      "versionNonce": 19248761,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785288778922,
      "link": null,
      "locked": false,
      "text": "Las imagenes estan \"salidas\" del\nscroll principal ya que sera una\nanimacion. Cada vez que alguien\nvaya scroleando se moveran de\nderecha a izquierda mostrando\nlas cards",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Las imagenes estan \"salidas\" del scroll principal ya que sera una animacion. Cada vez que alguien vaya scroleando se moveran de derecha a izquierda mostrando las cards",
      "autoResize": false,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
