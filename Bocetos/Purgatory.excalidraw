    {
      "id": "Va0_FRKtLxdaSeFTZ7Ocg",
      "type": "text",
      "x": 7089.04591083843,
      "y": -170.46036599148272,
      "width": 515.2354575115818,
      "height": 253,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#12b886",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
