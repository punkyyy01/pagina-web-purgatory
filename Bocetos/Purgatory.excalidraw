    {
      "id": "7pBpQHb99Pc94GWWoRWlp",
      "type": "text",
      "x": 27.67978300289832,
      "y": 1803.6196790291492,
      "width": 257.8105240738191,
      "height": 120,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "hachure",
      "strokeWidth": 4,
      "strokeStyle": "solid",
