    {
      "id": "KLGfikR0x87wsoxMduA-C",
      "type": "text",
      "x": 1648.659018924693,
      "y": 180.3504917705842,
      "width": 335.7421875,
      "height": 138,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#12b886",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0U",
      "roundness": null,
      "seed": 1496533539,
      "version": 970,
      "versionNonce": 1496667555,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785437760665,
      "link": null,
      "locked": false,
      "text": "Es la division de la categoria de alma:\n\n- Imagen\n- Epoca\n- Frase\n- Descripcion ",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Es la division de la categoria de alma:\n\n- Imagen\n- Epoca\n- Frase\n- Descripcion ",
      "autoResize": true,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "DGitVoGOON8tePU3qRAeT",
      "type": "text",
      "x": 1648.6590190373086,
      "y": 336.70548034801516,
      "width": 399.7479085517381,
      "height": 92,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#12b886",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0V",
      "roundness": null,
      "seed": 623644099,
      "version": 1156,
      "versionNonce": 2145429827,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785437760665,
      "link": null,
      "locked": false,
      "text": "Con esto, los usuarios pueden jugar con las\ncategorias, darse mejor a conocer, aparte de\ndiscord, y jugar con la perspectiva de los \ndemas hacia ellos mismos.",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Con esto, los usuarios pueden jugar con las\ncategorias, darse mejor a conocer, aparte de\ndiscord, y jugar con la perspectiva de los \ndemas hacia ellos mismos.",
      "autoResize": false,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
    {
      "id": "upS-EmTp6HvS7EQtwktR_",
      "type": "text",
      "x": 1648.659019567814,
      "y": 459.3552290472561,
      "width": 304.414357886727,
      "height": 115,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#12b886",
      "fillStyle": "solid",
      "strokeWidth": 4,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0W",
      "roundness": null,
      "seed": 1753963875,
      "version": 810,
      "versionNonce": 1226868963,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1785437760665,
      "link": null,
      "locked": false,
      "text": "Un 4LMA especial puede otorgar\npermisos especiales, ya\nque estas almas suelen ser o\nimportantes para el lore, o\nmoderadores/semi-moderadores",
      "fontSize": 20,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Un 4LMA especial puede otorgar permisos especiales, ya\nque estas almas suelen ser o importantes para el lore, o\nmoderadores/semi-moderadores",
      "autoResize": false,
      "lineHeight": 1.15,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
