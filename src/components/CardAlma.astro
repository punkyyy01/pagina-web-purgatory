---
import { getCalidadEfectiva, CALIDAD_LABELS, ERA_LABELS } from '../lib/alma.js';

/** @type {{ alma: import('../lib/alma.js').Alma }} */
const { alma } = Astro.props;

const calidad = getCalidadEfectiva(alma);
const eraLabel = ERA_LABELS[alma.era];
const inicial = alma.nick.trim().charAt(0).toUpperCase() || '?';
---
<article class="card-alma" data-calidad={calidad} data-presencia={alma.presencia}>
  <div class="card-alma__meta">
    <span>{eraLabel}</span>
    {alma.moteSuperior && <span>{alma.moteSuperior}</span>}
  </div>

  <div class="card-alma__avatar">
    {alma.avatarUrl
      ? <img src={alma.avatarUrl} alt="" loading="lazy" />
      : <div class="card-alma__fallback" aria-hidden="true" data-initial={inicial}></div>
    }
  </div>

  <div class="card-alma__body">
    <h3 class="card-alma__nick">{alma.nick}</h3>
    {alma.moteInferior && <div class="card-alma__mote-inferior">{alma.moteInferior}</div>}
    {alma.fraseIconica && <blockquote class="card-alma__frase">"{alma.fraseIconica}"</blockquote>}
    {calidad !== 'normal' && (
      <span class="stamp card-alma__stamp">{CALIDAD_LABELS[calidad]}</span>
    )}
  </div>
</article>
