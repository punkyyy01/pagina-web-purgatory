---
interface Props {
  active?: 'inicio' | 'lore' | 'personajes' | 'eventos' | 'condenados' | null;
}

const { active = null } = Astro.props;

const links: Array<{ key: NonNullable<Props['active']>; href: string; label: string }> = [
  { key: 'inicio', href: '/', label: 'Inicio' },
  { key: 'personajes', href: '/personajes', label: 'Personajes' },
  { key: 'lore', href: '/lore', label: 'Lore' },
  { key: 'eventos', href: '/eventos', label: 'Eventos' },
  { key: 'condenados', href: '/condenados', label: 'Condenados' },
];
---
<header class="site-header" id="site-header">
  <nav class="nav">
    <a class="brand wordmark-small" href="/">P</a>
    <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú">&#9776;</button>
    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li><a href={link.href} aria-current={active === link.key ? 'page' : undefined}>{link.label}</a></li>
      ))}
      <li class="nav-links-cta"><a class="btn btn--sm btn-blood cta" href="https://discord.gg/aTFMEVzcew" target="_blank" rel="noopener noreferrer">Server</a></li>
      <li class="nav-links-cta js-nav-login-item">
        <a class="nav-discord-link js-nav-login" href="/api/auth/login">
          <svg class="nav-discord-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.876 19.876 0 0 0 6.001-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.028zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.955 2.419-2.157 2.419zm7.974 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.946 2.419-2.157 2.419z"/></svg>
          <span>Iniciar sesión con Discord</span>
        </a>
      </li>
      <li class="nav-links-cta js-nav-user-mobile-item" hidden><a class="btn btn--sm" href="/cuenta"><span class="js-nav-user-name"></span></a></li>
      <li class="nav-links-cta js-nav-user-mobile-item" hidden>
        <form method="post" action="/api/auth/logout"><button type="submit" class="btn btn--sm">Cerrar sesión</button></form>
      </li>
    </ul>
    <div class="nav-end">
      <a class="btn btn--sm btn-blood cta" href="https://discord.gg/aTFMEVzcew" target="_blank" rel="noopener noreferrer">Server</a>
      <a class="nav-discord-link cta js-nav-login" href="/api/auth/login">
        <svg class="nav-discord-icon" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.317 4.37a19.79 19.79 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.056 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128c.126-.094.252-.192.372-.291a.074.074 0 0 1 .077-.01c3.927 1.793 8.18 1.793 12.061 0a.073.073 0 0 1 .078.009c.12.099.246.198.373.292a.077.077 0 0 1-.006.127 12.3 12.3 0 0 1-1.873.892.076.076 0 0 0-.04.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.876 19.876 0 0 0 6.001-3.03.077.077 0 0 0 .032-.055c.5-5.177-.838-9.674-3.549-13.66a.06.06 0 0 0-.031-.028zM8.02 15.331c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.955 2.419-2.157 2.419zm7.974 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.418 2.157-2.418 1.211 0 2.176 1.094 2.157 2.418 0 1.334-.946 2.419-2.157 2.419z"/></svg>
        <span>Iniciar sesión con Discord</span>
      </a>
      <div class="nav-user cta js-nav-user" hidden>
        <button class="nav-user__trigger js-nav-user-trigger" type="button" aria-expanded="false">
          <img class="nav-user__avatar js-nav-user-avatar" alt="" width="28" height="28" />
          <span class="js-nav-user-name"></span>
        </button>
        <div class="nav-user__menu">
          <a href="/cuenta">Mi cuenta</a>
          <form method="post" action="/api/auth/logout"><button type="submit">Cerrar sesión</button></form>
        </div>
      </div>
    </div>
  </nav>
</header>
