---
interface Props {
  active?: 'inicio' | 'lore' | 'personajes' | 'mapa' | 'eventos' | 'condenados' | null;
}

const { active = null } = Astro.props;

const links: Array<{ key: NonNullable<Props['active']>; href: string; label: string }> = [
  { key: 'inicio', href: '/', label: 'INICIO' },
  { key: 'personajes', href: '/personajes', label: 'PERSONAJES' },
  { key: 'lore', href: '/lore', label: 'LORE' },
  { key: 'mapa', href: '/mapa', label: 'MAPA' },
  { key: 'eventos', href: '/eventos', label: 'EVENTOS' },
  { key: 'condenados', href: '/condenados', label: 'CONDENADOS' },
];
---
<header class="site-header" id="site-header">
  <nav class="nav">
    <div class="nav-start">
      <a class="nav-brand" href="/" aria-label="PURG4TORY Inicio">
        <span class="nav-brand__p" aria-hidden="true">P</span>
        <span class="nav-brand__name">PURG<span class="seal-sm">4</span>TORY</span>
      </a>
      <span class="nav-slash" aria-hidden="true">/</span>
    </div>

    <button class="nav-toggle" id="nav-toggle" aria-label="Abrir menú" aria-expanded="false">&#9776;</button>

    <ul class="nav-links" id="nav-links">
      {links.map((link) => (
        <li class="nav-links__item">
          <a
            href={link.href}
            class:list={['nav-link', { 'is-active': active === link.key }]}
            aria-current={active === link.key ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="nav-end">
      <a class="btn btn--sm btn-nav-server" href="https://discord.gg/aTFMEVzcew" target="_blank" rel="noopener noreferrer">SERVIDOR</a>
      <a class="btn btn--sm btn-nav-discord js-nav-login" href="/api/auth/login">
        <svg class="discord-icon" viewBox="0 0 24 24" aria-hidden="true" width="16" height="16"><path fill="currentColor" d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.0777.0777 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
        <span>Iniciar sesión con Discord</span>
      </a>

      <!-- Logged-in user dropdown menu -->
      <div class="nav-user js-nav-user" hidden>
        <button class="nav-user__trigger js-nav-user-trigger" type="button" aria-expanded="false" aria-haspopup="true">
          <img class="nav-user__avatar js-nav-user-avatar" alt="" width="26" height="26" />
          <span class="nav-user__name js-nav-user-name"></span>
          <svg class="nav-user__caret" viewBox="0 0 12 12" width="12" height="12"><path fill="currentColor" d="M2 4l4 4 4-4z"/></svg>
        </button>

        <div class="nav-user__menu">
          <div class="nav-user__header">
            <img class="nav-user__header-avatar js-nav-user-avatar" alt="" width="36" height="36" />
            <div class="nav-user__header-text">
              <span class="nav-user__header-name js-nav-user-name"></span>
              <span class="nav-user__header-meta js-nav-user-meta"></span>
            </div>
          </div>
          <div class="nav-user__actions">
            <a href="/cuenta" class="nav-user__menu-item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="2"/><path d="M15 8h2M15 12h2M7 16h10"/></svg>
              <span>Card</span>
            </a>
            <a href="https://discord.gg/aTFMEVzcew" target="_blank" rel="noopener noreferrer" class="nav-user__menu-item">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.0777.0777 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/></svg>
              <span>Servidor</span>
            </a>
            <form method="post" action="/api/auth/logout">
              <button type="submit" class="nav-user__menu-item nav-user__menu-item--logout">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"/></svg>
                <span>Cerrar Sesión</span>
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </nav>
</header>
