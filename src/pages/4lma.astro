---
import Layout from '../layouts/Layout.astro';
import { getPublishedAlmas } from '../lib/db.js';
import { mergeAlma } from '../lib/alma.js';

// No se puede prerenderizar (build-time): tiene que reflejar las
// cartas reales publicadas, no una foto fija del momento del deploy.
export const prerender = false;

const publicadas = await getPublishedAlmas();
const almas = publicadas.map(({ discordMember, almaRow }) => mergeAlma(discordMember, almaRow));
---
<Layout title="4LMA — Purgatory" description="Galería de 4LMA publicadas por la comunidad de Purgatory.">
  <main>
    <h1>4LMA</h1>
    <p>Frontend visual en reconstrucción. Listado sin diseño, a propósito.</p>

    <ul>
      {almas.map((alma) => <li>{alma.nick} — {alma.era}</li>)}
    </ul>

    <p><a href="/">Inicio</a></p>
  </main>
</Layout>
