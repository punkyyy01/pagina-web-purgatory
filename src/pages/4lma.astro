---
import Layout from '../layouts/Layout.astro';
import CardAlma from '../components/CardAlma.astro';
import { almasSemilla } from '../data/almas-semilla.js';
import { getPublishedAlmas } from '../lib/db.js';
import { mergeAlma, getGalleryAlmas } from '../lib/alma.js';

// No se puede prerenderizar (build-time): tiene que reflejar las
// cartas reales publicadas, no una foto fija del momento del deploy.
export const prerender = false;

const publicadas = await getPublishedAlmas();
const almasReales = publicadas.map(({ discordMember, almaRow }) => mergeAlma(discordMember, almaRow));
const almas = getGalleryAlmas(almasReales, almasSemilla);
---
<Layout
  title="4LMA — Purgatory"
  description="La galería de 4LMAs de PURG4TORY: la identidad de cada usuario dentro del universo del servidor."
  ogTitle="4LMA — PURG4TORY"
  ogDescription="La galería de 4LMAs de PURG4TORY: la identidad de cada usuario dentro del universo del servidor."
  path="/4lma"
  active={null}
>

  <section class="page-hero">
    <div class="container">
      <h1 class="section-title">4LMA</h1>
      <p class="section-lead">
        La colección viva de quienes forman parte de Purgatory — cada alma, a su manera.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="naipe-grid">
        {almas.map((alma) => <CardAlma alma={alma} />)}
      </div>
    </div>
  </section>

</Layout>
