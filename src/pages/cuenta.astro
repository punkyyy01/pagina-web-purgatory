---
import Layout from '../layouts/Layout.astro';
import { getSessionUser } from '../lib/auth.js';
import { deriveRol } from '../lib/alma.js';

export const prerender = false;

const session = await getSessionUser(Astro.cookies);
const error = Astro.url.searchParams.get('error');

const ERROR_MESSAGES = {
  oauth_state: 'Algo no cuadró al volver de Discord — probablemente el intento de login expiró. Probá de nuevo.',
  oauth_denied: 'Discord no autorizó el inicio de sesión.',
  discord_unreachable: 'No se pudo contactar a Discord ahora mismo. Probá de nuevo en un momento.',
};
const errorMessage = error ? ERROR_MESSAGES[error] ?? 'Ocurrió un error iniciando sesión.' : null;

const isMember = session?.member?.isMember ?? false;
const esModerador = deriveRol(session?.member ?? null) === 'moderador';
---
<Layout
  title="Mi cuenta — Purgatory"
  description="Tu cuenta de PURG4TORY."
  ogTitle="Mi cuenta — PURG4TORY"
  ogDescription="Tu cuenta de PURG4TORY."
  path="/cuenta"
  active={null}
>

  <section class="page-hero">
    <div class="container">
      <h1 class="section-title">Mi cuenta</h1>
      <p class="section-lead">
        {session ? 'Tu identidad dentro de Purgatory.' : 'Iniciá sesión con Discord para continuar.'}
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 620px">

      {errorMessage && (
        <div class="record" style="margin-bottom: var(--space-6)">
          <p class="record-desc" style="opacity:1">{errorMessage}</p>
        </div>
      )}

      {!session && (
        <div class="record">
          <div class="record-meta">Sin sesión</div>
          <p class="record-desc">Iniciá sesión con tu cuenta de Discord para acceder a tu 4LMA.</p>
          <div class="section-cta">
            <a href="/api/auth/login" class="btn btn-blood">Iniciar sesión con Discord</a>
          </div>
        </div>
      )}

      {session && !isMember && (
        <div class="record">
          <div class="record-meta">Discord ID {session.discordId}</div>
          <h2 class="record-name">Todavía no sos parte de Purgatory</h2>
          <p class="record-desc">
            Iniciaste sesión, pero no encontramos tu cuenta como miembro activo del servidor —
            entrá primero y volvé a esta página.
          </p>
          <div class="section-cta">
            <a href="https://discord.gg/aTFMEVzcew" class="btn btn-blood" target="_blank" rel="noopener noreferrer">Entrar al Server</a>
            <form method="post" action="/api/auth/logout">
              <button type="submit" class="btn">Cerrar sesión</button>
            </form>
          </div>
        </div>
      )}

      {session && isMember && (
        <div class="record">
          <div class="record-meta">Discord ID {session.discordId}</div>
          <h2 class="record-name">{session.member.globalName || session.member.username}</h2>
          <p class="record-desc">Sesión iniciada — sos miembro verificado de Purgatory.</p>
          <div class="section-cta">
            <a href="/cuenta/editar" class="btn btn-blood">Editar mi 4LMA</a>
            {esModerador && <a href="/staff/almas" class="btn">Panel de Staff</a>}
            <form method="post" action="/api/auth/logout">
              <button type="submit" class="btn">Cerrar sesión</button>
            </form>
          </div>
        </div>
      )}

    </div>
  </section>

</Layout>
