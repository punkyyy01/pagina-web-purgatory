---
import Layout from '../layouts/Layout.astro';
import { getSessionUser } from '../lib/auth.js';
import { deriveRol } from '../lib/alma.js';

export const prerender = false;

const session = await getSessionUser(Astro.cookies);
const error = Astro.url.searchParams.get('error');

const ERROR_MESSAGES = {
  oauth_state: 'Algo no cuadró al volver de Discord — probablemente el intento de login expiró. Probá de nuevo.',
  oauth_denied: 'Discord no autorizó el inicio de sesión.',
  discord_unreachable: 'No se pudo contactar a Discord ahora mismo. Probá de nuevo en un momento.',
};
const errorMessage = error ? ERROR_MESSAGES[error] ?? 'Ocurrió un error iniciando sesión.' : null;

const isMember = session?.member?.isMember ?? false;
const esModerador = deriveRol(session?.member ?? null) === 'moderador';
---
<Layout title="Cuenta — Purgatory" description="Tu cuenta de Purgatory.">
  <main>
    <h1>Cuenta</h1>
    <p>Frontend visual en reconstrucción. Sin diseño todavía, a propósito.</p>

    {errorMessage && <p role="alert">{errorMessage}</p>}

    {!session && (
      <p><a href="/api/auth/login">Iniciar sesión con Discord</a></p>
    )}

    {session && !isMember && (
      <p>Iniciaste sesión, pero tu cuenta de Discord no es miembro del servidor.</p>
    )}

    {session && isMember && (
      <>
        <p>Sesión iniciada como {session.member.globalName ?? session.member.username}.</p>
        <p><a href="/cuenta/editar">Editar mi 4LMA</a></p>
        {esModerador && <p><a href="/staff/almas">Panel de staff</a></p>}
        <form method="post" action="/api/auth/logout">
          <button type="submit">Cerrar sesión</button>
        </form>
      </>
    )}

    <p><a href="/">Inicio</a></p>
  </main>
</Layout>
