---
import Layout from '../../layouts/Layout.astro';
import { getSessionUser } from '../../lib/auth.js';
import { getAlma } from '../../lib/db.js';
import { mergeAlma, getCalidadEfectiva, CALIDAD_LABELS, ERA_LABELS } from '../../lib/alma.js';

export const prerender = false;

const session = await getSessionUser(Astro.cookies);
if (!session || !session.member?.isMember) {
  return Astro.redirect('/cuenta');
}

const almaRow = await getAlma(session.discordId);
const alma = mergeAlma(session.member, almaRow);
const calidadEfectiva = getCalidadEfectiva(alma);

const guardado = Astro.url.searchParams.get('guardado') === '1';
const error = Astro.url.searchParams.get('error');
const ERROR_MESSAGES = {
  nick_requerido: 'El nick no puede quedar vacío.',
};
const errorMessage = error ? ERROR_MESSAGES[error] ?? 'Algo salió mal guardando tu 4LMA.' : null;
---
<Layout title="Editar mi 4LMA — Purgatory" description="Card Builder de tu 4LMA.">
  <main>
    <h1>Editar mi 4LMA</h1>
    <p>Frontend visual en reconstrucción — este es el Card Builder sin diseño, a propósito. El formulario ya guarda en serio.</p>

    {guardado && <p role="status">Guardado.</p>}
    {errorMessage && <p role="alert">{errorMessage}</p>}
    {calidadEfectiva !== 'normal' && <p>Calidad actual: {CALIDAD_LABELS[calidadEfectiva]}</p>}

    <form method="post" action="/api/alma/save">
      <p>
        <label>
          Nick<br />
          <input type="text" name="nick" value={alma.nick} maxlength="40" required />
        </label>
      </p>

      <p>
        <label>
          Era<br />
          <select name="era">
            {Object.entries(ERA_LABELS).map(([key, label]) => (
              <option value={key} selected={alma.era === key}>{label}</option>
            ))}
          </select>
        </label>
      </p>

      <p>
        <label>
          Mote superior<br />
          <input type="text" name="moteSuperior" value={alma.moteSuperior} maxlength="60" />
        </label>
      </p>

      <p>
        <label>
          Mote inferior<br />
          <input type="text" name="moteInferior" value={alma.moteInferior} maxlength="60" />
        </label>
      </p>

      <p>
        <label>
          Frase icónica<br />
          <input type="text" name="fraseIconica" value={alma.fraseIconica} maxlength="140" />
        </label>
      </p>

      <p>
        <label>
          Descripción<br />
          <textarea name="descripcion" maxlength="600">{alma.descripcion}</textarea>
        </label>
      </p>

      <p>
        <label>
          <input type="checkbox" name="estadoPublicacion" value="publicada" checked={alma.estadoPublicacion === 'publicada'} />
          Publicar (visible en la galería de 4LMA)
        </label>
      </p>

      <button type="submit">Guardar</button>
    </form>

    <p><a href="/cuenta">Volver a mi cuenta</a></p>
  </main>
</Layout>
