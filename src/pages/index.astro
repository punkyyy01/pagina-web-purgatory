---
import Layout from '../layouts/Layout.astro';
import { getPublishedAlmas } from '../lib/db.js';
import { mergeAlma } from '../lib/alma.js';

// No se puede prerenderizar (build-time): tiene que reflejar las
// cartas reales publicadas, no una foto fija del momento del deploy.
export const prerender = false;

const publicadas = await getPublishedAlmas();
const almas = publicadas.map(({ discordMember, almaRow }) => mergeAlma(discordMember, almaRow));
---
<Layout title="Purgatory" description="Comunidad del servidor de Discord Purgatory.">
  <main>
    <h1>Purgatory</h1>
    <p>
      Frontend visual en reconstrucción — esta página solo confirma que la carga de datos
      (almas publicadas) sigue funcionando. Sin diseño todavía a propósito.
    </p>

    <h2>4LMA publicadas ({almas.length})</h2>
    <ul>
      {almas.map((alma) => <li>{alma.nick} — {alma.era}</li>)}
    </ul>

    <p><a href="/4lma">Ver todas</a> · <a href="/cuenta">Mi cuenta</a></p>
  </main>
</Layout>
