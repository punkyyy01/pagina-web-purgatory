---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---
<Layout
  title="Mapa — Purgatory"
  description="Mapa de los cuatro servidores de PURG4TORY y los eventos que los definieron."
  ogTitle="Mapa del Purgatorio — PURG4TORY"
  ogDescription="Los cuatro servidores y los eventos que los definieron."
  path="/mapa"
  active="mapa"
>
  <section class="page-hero">
    <div class="container">
      <h1 class="section-title">Mapa del Purgatorio</h1>
      <p class="section-lead">Los cuatro servidores y los eventos que los definieron.</p>
    </div>
  </section>

  <section class="section">
    <div class="container" style="max-width: 800px; text-align: center;">
      <div class="record" style="padding: var(--space-8) var(--space-6);">
        <div class="record-meta">CARTOGRAFÍA CANÓNICA</div>
        <h2 style="font-family: var(--font-serif); font-size: var(--fs-2xl); color: var(--paper); margin: var(--space-4) 0;">En Proceso...</h2>
        <p class="record-desc" style="max-width: 520px; margin: 0 auto var(--space-6); opacity: 1;">
          La cartografía territorial que conecta Las Fosas, Los Pibes Shitposters, Olympo y PURG4TORY se encuentra en desarrollo.
        </p>
        <div style="display: flex; justify-content: center; gap: var(--space-4); flex-wrap: wrap;">
          <a href="/lore" class="btn btn-blood">Explorar el Lore</a>
          <a href="/personajes" class="btn">Ver Personajes</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
