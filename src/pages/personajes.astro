---
import Layout from '../layouts/Layout.astro';

export const prerender = true;
---
<Layout
  title="Personajes — Purgatory"
  description="Galería completa de personajes canónicos de Purgatory. Sus historias, alianzas y momentos más icónicos."
  ogTitle="Personajes — PURG4TORY"
  ogDescription="El registro completo de Purgatory. Once almas canónicas, sus momentos y sus chismes."
  path="/personajes"
  active="personajes"
  extraScripts={["/static/data/personajes-data.js"]}
>

  <!-- Hero -->
  <section class="page-hero">
    <div class="container">
      <h1 class="section-title">Personajes Canónicos</h1>
      <p class="section-lead">Once almas de la historia real del servidor — quiénes son, en qué era aparecieron y qué los hizo memorables.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">

      <div class="filter-tabs" id="char-filters">
        <button class="filter-tab active" data-filter="all">Todos</button>
        <button class="filter-tab" data-filter="fosas">Las Fosas</button>
        <button class="filter-tab" data-filter="olympo">Olympo</button>
        <button class="filter-tab" data-filter="purgatory">Purgatory</button>
      </div>

      <div style="margin-bottom: var(--space-6)">
        <input type="search" id="char-search" placeholder="Buscar personaje..." class="char-search-input">
      </div>

      <!-- Grid de naipes — generado por JS -->
      <div class="naipe-grid" id="char-grid"></div>

    </div>
  </section>

  <!-- Modal ficha de personaje -->
  <div id="char-detail-modal" class="modal" aria-hidden="true" role="dialog" aria-modal="true" aria-labelledby="modal-char-name">
    <div class="modal-panel" style="max-width:700px">
      <button class="modal-close" id="modal-close" aria-label="Cerrar">&#215;</button>
      <div id="char-modal-content"></div>
    </div>
  </div>

</Layout>
