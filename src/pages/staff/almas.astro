---
import Layout from '../../layouts/Layout.astro';
import { getSessionUser } from '../../lib/auth.js';
import { searchMembersForAdmin } from '../../lib/db.js';
import { deriveRol } from '../../lib/alma.js';

export const prerender = false;

const session = await getSessionUser(Astro.cookies);
const rolSolicitante = deriveRol(session?.member ?? null);
if (!session || rolSolicitante !== 'moderador') {
  return Astro.redirect('/cuenta');
}

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const resultados = q ? await searchMembersForAdmin(q) : [];
---
<Layout title="Staff · Almas — Purgatory" description="Panel de moderación de 4LMA.">
  <main>
    <h1>Staff · Almas</h1>
    <p>Frontend visual en reconstrucción, sin diseño a propósito. La búsqueda y las acciones de logro ya funcionan de verdad.</p>

    <form method="get" action="/staff/almas">
      <label>
        Buscar (username o Discord ID)<br />
        <input type="text" name="q" value={q} />
      </label>
      <button type="submit">Buscar</button>
    </form>

    {q && resultados.length === 0 && <p>Sin resultados para "{q}".</p>}

    <ul>
      {resultados.map((r) => (
        <li>
          {r.username} ({r.discordId}) — nick: {r.nick || '—'} — calidad: {r.calidad}
          {' '}
          {r.calidadMotivo === 'logro' ? (
            <form method="post" action="/api/alma/admin/logro" style="display:inline">
              <input type="hidden" name="discordId" value={r.discordId} />
              <input type="hidden" name="accion" value="revocar" />
              <button type="submit">Revocar logro</button>
            </form>
          ) : (
            <form method="post" action="/api/alma/admin/logro" style="display:inline">
              <input type="hidden" name="discordId" value={r.discordId} />
              <input type="hidden" name="accion" value="otorgar" />
              <button type="submit">Otorgar logro</button>
            </form>
          )}
        </li>
      ))}
    </ul>

    <p><a href="/cuenta">Volver a mi cuenta</a></p>
  </main>
</Layout>
